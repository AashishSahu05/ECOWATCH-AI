# ==============================================================================
# EcoWatch AI — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local, production credentials, or real secret keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Platform (Multimodal Vision & Root Cause Intelligence)
# ------------------------------------------------------------------------------
# Required for live waste segregation perception, civic dumping analysis, and
# operational root cause synthesis. If omitted, the platform activates
# realistic heuristic fallback simulation with explicit [MOCK] badges.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Google Maps Platform (Geocoding, Incident Mapping, Cluster Heatmaps)
# ------------------------------------------------------------------------------
# Required for client-side Google Maps rendering, draggable incident geocoding,
# and spatial cluster maps. If omitted or billing-paused, reverse geocoding
# automatically fails over to local landmark heuristic matching.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_optional_map_id_here

# ------------------------------------------------------------------------------
# 3. Development & Staging Demo Authentication (Dual-Adapter Architecture)
# ------------------------------------------------------------------------------
# Enables cryptographically signed (HMAC-SHA256) session cookies for staging,
# evaluation, and automated end-to-end testing without external database dependencies.
# Note: In production, demo authentication is strictly isolated and rejected.
NEXT_PUBLIC_ECOWATCH_ENABLE_DEMO_AUTH=true
ECOWATCH_DEMO_AUTH_SECRET=your_32_character_demo_auth_secret_minimum_length_here

# ------------------------------------------------------------------------------
# 4. Supabase Database & Auth (Active Database Integration)
# ------------------------------------------------------------------------------
# EcoWatch AI connects to Supabase PostgreSQL database and Auth service.
# Uses NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (modern) and NEXT_PUBLIC_SUPABASE_ANON_KEY (legacy).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 5. Application Host & Telemetry Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
